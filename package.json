{
  "name": "my-packs-pro",
  "version": "0.1.0",
  "description": "My Packs Pro - painel CEP de assets locais para Adobe Premiere Pro",
  "author": "Alex Ascencio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "install:panel": "powershell -ExecutionPolicy Bypass -File install-panel.ps1",
    "install:panel:bash": "bash install-panel.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
